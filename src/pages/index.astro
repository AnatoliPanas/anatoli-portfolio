---
import "../styles/global.css";
import { translations } from "../scripts/translations.js";

const skills = [
  "C#",
  ".NET",
  "ASP.NET Core",
  "Python",
  "Django",
  "SQL",
  "PostgreSQL",
  "Oracle",
  "Docker",
  "Git",
];

const projects = [
  {
    name: "HomeRentEasy",
    type: "Web Application",
    description:
      "Eine Webanwendung mit Django und Datenbankintegration. Entwickelt mit Docker Compose.",
    stack: ["Python", "Django", "SQL", "Docker"],
  },
  {
    name: "Backend Development",
    type: "Professional Experience",
    description:
      "Erfahrung mit Backend-Systemen, Datenbanken und der Entwicklung zuverlässiger Softwarelösungen.",
    stack: ["C#", ".NET", "SQL"],
