---
import "../styles/global.css";
import { translations } from "../scripts/translations.js";

const skills = [
  "C#",
  ".NET",
  "ASP.NET Core",
  "Python",
  "Django",
  "SQL",
  "PostgreSQL",
  "Oracle",
  "Docker",
  "Git",
];

const projects = [
  {
    name: "HomeRentEasy",
    type: "Web Application",
    description:
      "Eine Webanwendung mit Django und Datenbankintegration. Entwickelt mit Docker Compose.",
    stack: ["Python", "Django", "SQL", "Docker"],
  },
  {
    name: "Backend Development",
    type: "Professional Experience",
    description:
      "Erfahrung mit Backend-Systemen, Datenbanken und der Entwicklung zuverlässiger Softwarelösungen.",
    stack: ["C#", ".NET", "SQL"],
  },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Anatoli Panas – Software Developer mit Erfahrung in Backend-Entwicklung, .NET, Python und Datenbanken."
    />
    <meta name="theme-color" content="#0b1020" />
    <title>Anatoli Panas | Software Developer</title>
  </head>

  <body>
    <header class="site-header">
      <nav class="nav container" aria-label="Hauptnavigation">
        <a class="brand" href="#home">AP<span>.</span></a>

        <div class="nav-links">
          <a href="#about" data-i18n="navAbout">Über mich</a>
          <a href="#skills" data-i18n="navSkills">Skills</a>
          <a href="#projects" data-i18n="navProjects">Projekte</a>
          <a href="#experience" data-i18n="navExperience">Erfahrung</a>
        </div>

        <div class="language-switcher" aria-label="Sprache wählen">
          <button type="button" data-lang="de" class="active">DE</button>
          <button type="button" data-lang="en">EN</button>
          <button type="button" data-lang="ru">RU</button>
        </div>

        <a class="nav-cta" href="#contact">
          <span data-i18n="navContact">KONTAKT</span>
          <span>↗</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="hero container" id="home">
        <div class="hero-copy">
          <div class="availability" data-i18n="status">
            <span class="status-dot"></span>
            Software Developer · Nürnberg, Deutschland
          </div>

          <p class="eyebrow" data-i18n="greeting">HALLO, ICH BIN</p>
          <h1>Anatoli Panas<span class="accent">.</span></h1>

          <h2 data-i18n="heroTitle">
            Ich entwickle <span class="gradient-text">Software</span>, die
            Probleme löst.
          </h2>

          <p class="hero-description" data-i18n="heroDescription">
            Softwareentwickler mit langjähriger Berufserfahrung. Mein
            Schwerpunkt liegt auf Backend-Entwicklung, C#, Python und
            relationalen Datenbanken.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="#projects" data-i18n="projectsButton">
              Projekte entdecken <span>↘</span>
            </a>
            <a
              class="button button-secondary"
              href="https://www.linkedin.com/in/anatoli-panas"
              target="_blank"
              rel="noreferrer"
            >
              LinkedIn <span>↗</span>
            </a>
            <a
              class="button button-secondary"
              href="/Lebenslauf.pdf"
              download="Anatoli-Panas-Lebenslauf.pdf"
              data-i18n="lebenslaufButton"
            >
              Lebenslauf herunterladen <span>↓</span>
            </a>
          </div>

          <div class="hero-meta">
            <span data-i18n="metaBackend">Backend Development</span>
            <span data-i18n="metaDotnet">C# & Python</span>
            <span data-i18n="metaSql">SQL & Datenbanken</span>
          </div>
        </div>

        <div class="hero-visual">
          <div class="visual-glow"></div>
          <div class="profile-frame">
            <div class="profile-placeholder">
              <img
                src="/images/profile.jpg"
                alt="Anatoli Panas, Software Developer"
                class="profile-photo"
              />
            </div>
            <div class="profile-caption">
              <strong data-i18n="metaBackend">SOFTWARE DEVELOPER</strong>
              <span class="caption-location" data-i18n="metaCity">Nürnberg, Deutschland</span>
            </div>
          </div>

          <div class="floating-card floating-code">
            <span class="code-icon">&lt;/&gt;</span>
            <div>
              <strong>Clean Code</strong>
              <small>Thoughtful solutions</small>
            </div>
          </div>

          <div class="floating-card floating-stack">
            <span class="stack-dot"></span>
            <div>
              <strong>Backend</strong>
              <small>C# · Python · SQL</small>
            </div>
          </div>
        </div>

        <a class="scroll-cue" href="#about">
          <span class="scroll-line"></span>
          MEHR ENTDECKEN
        </a>
      </section>

      <section class="section container" id="about">
        <div class="section-heading">
          <p class="eyebrow" data-i18n="aboutEyebrow">ÜBER MICH</p>
          <h2 data-i18n="aboutTitle">
            Erfahrung trifft auf<br /><span class="muted-heading"
              >neue Ideen.</span
            >
          </h2>
        </div>

        <div class="about-grid">
          <p class="about-lead" data-i18n="aboutLead">
            Ich verbinde praktische Erfahrung in der Softwareentwicklung mit
            kontinuierlichem Lernen und neuen Technologien.
          </p>
          <div class="about-text">
            <p data-i18n="aboutDescription">
              Mein beruflicher Hintergrund umfasst die Entwicklung und Betreuung
              von Softwarelösungen, die Arbeit mit Datenbanken und die
              Unterstützung komplexer technischer Prozesse.
            </p>
            <p data-i18n="aboutDescription2">
              Heute vertiefe ich meine Kenntnisse in modernen Backend-
              Technologien und Python. Ich interessiere mich für durchdachte
              Softwarearchitektur, sauberen Code und Lösungen mit echtem Nutzen.
            </p>
          </div>
        </div>
      </section>

      <section class="section section-alt" id="skills">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow" data-i18n="technologiesEyebrow">TECHNOLOGIEN</p>
            <h2 data-i18n="skillsTitle">
              Mein technischer <span class="gradient-text">Werkzeugkasten.</span
              >
            </h2>
            <p class="section-intro" data-i18n="skillsIntro">
              Technologien, mit denen ich arbeite und meine Kenntnisse
              weiterentwickle.
            </p>
          </div>

          <div class="skill-grid">
            <article class="skill-card">
              <span class="skill-number">01</span>
              <div class="skill-symbol">⌘</div>
              <h3 data-i18n="backend">Backend</h3>
              <p>C# · .NET · ASP.NET Core · Python · Django · Java</p>
            </article>

            <article class="skill-card">
              <span class="skill-number">02</span>
              <div class="skill-symbol">▤</div>
              <h3 data-i18n="databases">Datenbanken</h3>
              <p>SQL · PostgreSQL · Oracle · MS SQL Server · MongoDB</p>
            </article>

            <article class="skill-card">
              <span class="skill-number">03</span>
              <div class="skill-symbol">⌘</div>
              <h3 data-i18n="tools">Tools & DevOps</h3>
              <p>Git · Docker · Linux · Jenkins · CI/CD</p>
            </article>

            <article class="skill-card">
              <span class="skill-number">04</span>
              <div class="skill-symbol">✳</div>
              <h3 data-i18n="webTesting">Web & Testing</h3>
              <p>HTML · CSS · JavaScript · REST APIs · Pytest</p>
            </article>
          </div>

          <div class="skill-tags" aria-label="Weitere Technologien">
            {
              skills.map((skill) => (
                <span class="skill-tag" key={skill}>
                  {skill}
                </span>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section container" id="projects">
        <div class="section-heading projects-heading">
          <div>
            <p class="eyebrow" data-i18n="projectsEyebrow">PROJEKTE</p>
            <h2 data-i18n="projectsTitle">Projekte & <span class="muted-heading">Praxis.</span></h2>
          </div>
          <span class="project-count">02 EINBLICKE</span>
        </div>

        <div class="project-grid">
          {
            projects.map((project, index) => (
              <article class="project-card" key={project.name}>
                <div class="project-art">
                  <span class="project-index">0{index + 1}</span>
                  <span class="project-art-symbol">
                    {index === 0 ? "⌘" : "{ }"}
                  </span>
                  <span class="project-art-label">{project.type}</span>
                </div>
                <div class="project-content">
                  <p class="project-type">{project.type}</p>
                  <h3>{project.name}</h3>
                  <p class="project-description">{project.description}</p>
                  <div class="project-tags">
                    {project.stack.map((item) => (
                      <span key={item}>{item}</span>
                    ))}
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <p class="section-note" data-i18n="projectNote">
          Weitere Projekte, Quellcode und technische Details werden ergänzt.
        </p>
      </section>

      <section class="section section-alt" id="experience">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow" data-i18n="experienceEyebrow">BERUFLICHER WEG</p>
            <h2 data-i18n="experienceTitle">
              Erfahrung & <span class="muted-heading">Qualifikation.</span>
            </h2>
          </div>

          <div class="timeline">
            <article class="timeline-item">
              <span class="timeline-marker"></span>
              <div>
                <p class="timeline-date">MAI 2026 – JULI 2026</p>
                <h3>Praktikum: AI Developer / Backend Application Developer</h3>
                <p class="timeline-company">
                  Zweckverband Naturpark Rheinland (in Kooperation mit TU
                  Berlin)
                </p>
                <p>
                  Integration von Sprachmodellen (LLMs) und Konzeption von
                  RAG-Architekturen. Entwicklung von APIs, Verbesserung der User
                  Experience und Optimierung automatisierter Gesprächsverläufe.
                  Prototyping und Übergabe eines funktionsfähigen KI-Chatbots.
                </p>
              </div>
            </article>

            <article class="timeline-item">
              <span class="timeline-marker"></span>
              <div>
                <p class="timeline-date">JUNI 2025 – AUGUST 2025</p>
                <h3>Web Developer / Backend Application Developer</h3>
                <p class="timeline-company">
                  Schule für Bildende Kunst und Gestaltung GmbH, Berlin
                </p>
                <p>
                  Entwicklung von Backend-Komponenten, Datenbanken und REST
                  APIs. Umsetzung neuer Funktionen mit Python, JavaScript und
                  React sowie Containerisierung mit Docker. Optimierung von
                  Performance und Softwarearchitektur in Zusammenarbeit mit dem
                  Frontend-Team.
                </p>
              </div>
            </article>

            <article class="timeline-item">
              <span class="timeline-marker"></span>
              <div>
                <p class="timeline-date">FEBRUAR 2010 – JULI 2022</p>
                <h3>Softwareentwickler</h3>
                <p class="timeline-company">Surgutneftegas</p>
                <p>
                  Entwicklung und Betreuung von Softwarelösungen für über 500
                  Nutzer. Arbeit an Backend-Systemen, Schnittstellen, Web- und
                  Desktop-Anwendungen sowie Datenbankdesign und
                  Systemarchitektur. Optimierung bestehender Anwendungen,
                  Entwicklungsprozesse und CI/CD-Pipelines. Unterstützung des
                  Teams bei technischen Problemen und Einarbeitung neuer
                  Mitarbeiter.
                </p>
                <p>
                  <strong>Technologien:</strong> C#, ASP.NET, .NET, .NET Core, Delphi,
                  JavaScript, SQL, PL/SQL, HTML, CSS, Oracle, PostgreSQL, MongoDB,
                  SVN, Jenkins, SonarQube.
                </p>
              </div>
            </article>

            <article class="timeline-item">
              <span class="timeline-marker"></span>
              <div>
                <p class="timeline-date">SEPTEMBER 2024 – JUNI 2025</p>
                <h3>Weiterbildung: Python & Künstliche Intelligenz</h3>
                <p class="timeline-company">IT Career Hub GmbH, Berlin</p>
                <p>
                  Weiterbildung in Python, Webentwicklung, APIs, Testing, Docker
                  und modernen Entwicklungsmethoden.
                </p>
              </div>
            </article>

            <article class="timeline-item">
              <span class="timeline-marker"></span>
              <div>
                <p class="timeline-date">JUNI 2022 – JUNI 2024</p>
                <h3>Deutschkurse und Integration bis Niveau B2</h3>
                <p class="timeline-company">Nürnberg</p>
              </div>
            </article>

            <article class="timeline-item">
              <span class="timeline-marker"></span>
              <div>
                <p class="timeline-date">2003 – 2008</p>
                <h3>Diplom-Ingenieur für Softwareentwicklung</h3>
                <p class="timeline-company">
                  Staatliche Technische Universität Omsk
                </p>
                <p>
                  Fachrichtung „Automatisierte Datenverarbeitungs- und
                  Steuerungssysteme“. Die Gleichwertigkeit des Abschlusses wurde
                  durch eine ZAB-Zeugnisbewertung bestätigt.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="contact-section container" id="contact">
        <p class="eyebrow" data-i18n="navContact">KONTAKT</p>
        <h2 data-i18n="contactTitle">
          Lass uns über<br /><span class="gradient-text"
            >Software sprechen.</span
          >
        </h2>
        <p data-i18n="contactDescription">
          Du suchst Unterstützung für ein Projekt oder möchtest dich fachlich
          austauschen? Ich freue mich auf deine Nachricht.
        </p>
        <a
          class="button button-primary"
          href="https://www.linkedin.com/in/anatoli-panas"
          target="_blank"
          rel="noreferrer"
          data-i18n="contactButton"
        >
          Kontakt über LinkedIn <span>↗</span>
        </a>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <a class="brand" href="#home">AP<span>.</span></a>
        <p>© {new Date().getFullYear()} Anatoli Panas</p>
        <a href="#home" data-i18n="backToTop">Zurück nach oben ↑</a>
      </div>
    </footer>
    <script>
      import { translations } from "../scripts/translations.js";

      type Language = "de" | "en" | "ru";

      function setLanguage(lang: Language) {
        const dictionary = translations[lang];

        document.documentElement.lang = lang;

        document
          .querySelectorAll<HTMLElement>("[data-i18n]")
          .forEach((element) => {
            const key = element.dataset.i18n as keyof typeof dictionary;
            const value = dictionary[key];

            if (value !== undefined) {
              element.innerHTML = value;
            }
          });

        document
          .querySelectorAll<HTMLButtonElement>("[data-lang]")
          .forEach((button) => {
            const active = button.dataset.lang === lang;
            button.classList.toggle("active", active);
            button.setAttribute("aria-pressed", String(active));
          });

        localStorage.setItem("portfolio-language", lang);
      }

      document
        .querySelectorAll<HTMLButtonElement>("[data-lang]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const lang = button.dataset.lang;

            if (lang === "de" || lang === "en" || lang === "ru") {
              setLanguage(lang);
            }
          });
        });

      const savedLanguage = localStorage.getItem("portfolio-language");
      const initialLanguage: Language =
        savedLanguage === "en" || savedLanguage === "ru" ? savedLanguage : "de";

      setLanguage(initialLanguage);
    </script>
  </body>
</html>
